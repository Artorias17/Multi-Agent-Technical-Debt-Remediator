{
  "name": "Thesis",
  "dockerComposeFile": "docker-compose.yml",
  "service": "python",
  "workspaceFolder": "/workspace/thesis",
  "forwardPorts": [9000, 9092, 5432],
  "features": {
    "ghcr.io/cirolosapio/devcontainers-features/alpine-bash:0": {},
    "ghcr.io/cirolosapio/devcontainers-features/alpine-git:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "github.copilot",
        "anthropic.claude-code",
        "eamodio.gitlens",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "formulahendry.auto-complete-tag",
        "ecmel.vscode-html-css",
        "ms-vscode.vscode-typescript-next",
        "christian-kohler.path-intellisense",
        "christian-kohler.npm-intellisense",
        "github.copilot-chat",
        "mechatroner.rainbow-csv",
        "ms-python.black-formatter",
        "ritwickdey.liveserver",
        "ms-vscode-remote.remote-containers",
        "prisma.prisma"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "postCreateCommand": "pip install uv"
}
