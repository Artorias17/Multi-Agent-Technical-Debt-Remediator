# GitHub personal access token — needs repo + pull request write permissions
GITHUB_TOKEN=

# SonarQube API token (Bearer) — generate at My Account → Security → Generate Tokens
SONARQUBE_TOKEN=

# LLM provider — The pipeline uses any OpenAI-compatible API.

OLLAMA_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
OLLAMA_BASE_URL=https://api.featherless.ai/v1
OLLAMA_API_KEY=


# DEBUG OUTPUTS
DEBUG=true