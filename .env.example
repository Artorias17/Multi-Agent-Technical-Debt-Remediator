# GitHub personal access token — needs repo + pull request write permissions
GITHUB_TOKEN=

# SonarQube API token (Bearer) — generate at My Account → Security → Generate Tokens
SONARQUBE_TOKEN=

# Ollama model to use for all LLM agents (default: qwen2.5-coder:7b)
OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama API base URL (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1
